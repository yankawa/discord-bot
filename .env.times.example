# Create a dedicated Discord application for times-bot.
DISCORD_TOKEN=replace_with_times_bot_bot_token
GUILD_ID=replace_with_server_id
CATEGORY_IDS=replace_with_category_id

# Keep the original state filename to preserve existing bot state.
STATE_FILE=./data/owner.json
RECONCILE_INTERVAL_SECONDS=60
REQUEST_TIMEOUT_SECONDS=30
WORKERS=4
QUEUE_CAPACITY=1024
