# Create a second Discord application for utils-bot.
# Enable MESSAGE CONTENT INTENT in its Developer Portal Bot settings.
DISCORD_TOKEN=replace_with_utils_bot_bot_token
GUILD_ID=replace_with_server_id

# Empty means all accessible channels in the configured server.
# IDs are exact channel/thread IDs, not category IDs.
CHANNEL_IDS=
MAX_LINKS=5
RETENTION_DAYS=7

# Keep the original state filename to preserve existing bot state.
STATE_FILE=./data/links.json
RECONCILE_INTERVAL_SECONDS=300
REQUEST_TIMEOUT_SECONDS=30
WORKERS=4
QUEUE_CAPACITY=1024
