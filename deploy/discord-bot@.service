[Unit]
Description=Discord bot (%i)
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=discordbots
Group=discordbots
WorkingDirectory=/opt/discord-bots
EnvironmentFile=/etc/discord-bots/%i.env
ExecStart=/opt/discord-bots/bin/%i
Restart=on-failure
RestartSec=10
TimeoutStopSec=40
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/discord-bots/data

[Install]
WantedBy=multi-user.target
